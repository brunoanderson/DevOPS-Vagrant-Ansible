# Projeto 01 - DevOps com Vagrant e Ansible
# arq: 192.168.56.1XX (XX = 2 últimos dígitos da matrícula do 1º integrante) - fixo
# db:  192.168.56.1YY (YY = 2 últimos dígitos da matrícula do 2º integrante) - DHCP, reserva por MAC
# app: 192.168.56.1XY (último dígito de cada matrícula)                     - DHCP, reserva por MAC
# cli: 192.168.56.60  (reserva por MAC dentro da faixa dinâmica .50-.100)
# db, app e cli só respondem depois que o DHCP da arq estiver ativo (playbooks/arq.yml).

[servidores]
arq ansible_host=192.168.56.112
db  ansible_host=192.168.56.114
app ansible_host=192.168.56.124
cli ansible_host=192.168.56.60

[all:vars]
ansible_user=vagrant
